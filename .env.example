# Single-node RF1 broker tuning.
SHARD_STREAM_MAX_BATCH_BYTES=4194304
SHARD_STREAM_MAX_REQUEST_BYTES=33554432
SHARD_STREAM_MAX_FETCH_BYTES=67108864
SHARD_STREAM_APPEND_LINGER_MS=1
SHARD_STREAM_KAFKA_PROFILE_SAMPLE_STRIDE=0
SHARD_STREAM_MAX_IN_FLIGHT_BATCHES=4096
SHARD_STREAM_LANE_BUFFER_BYTES=536870912
SHARD_STREAM_OBJECT_PACK_BYTES=134217728
SHARD_STREAM_MAX_PACK_AGE_MS=1000
SHARD_STREAM_VIRTUAL_LANES=16

# Optional for local administrative REST operations.
SHARD_STREAM_ADMIN_TOKEN=replace-with-a-high-entropy-secret

# Native Rust producer tuning, read by ClientConfig::from_env().
SHARD_STREAM_BATCH_SIZE=2097152
SHARD_STREAM_LINGER_MS=20
SHARD_STREAM_MAX_REQUEST_SIZE=4194304
