# Broker admission and shard-local group-fsync tuning.
SHARD_STREAM_MAX_BATCH_BYTES=16777216
SHARD_STREAM_MAX_REQUEST_BYTES=33554432
SHARD_STREAM_MAX_FETCH_BYTES=67108864
SHARD_STREAM_APPEND_LINGER_MS=1

# Static multi-node mode. Every node must receive the same node list and token.
# SHARD_STREAM_NODE_ID=0
# SHARD_STREAM_CLUSTER_TOKEN=replace-with-a-high-entropy-secret
# SHARD_STREAM_CLUSTER_NODES=0@http://node-0:7420@https://node-0.example:7420@https://node-0.example:7421@node-0.example:9092,1@http://node-1:7420@https://node-1.example:7420@https://node-1.example:7421@node-1.example:9092

# Native Rust producer tuning, read by ClientConfig::from_env().
SHARD_STREAM_BATCH_SIZE=16384
SHARD_STREAM_LINGER_MS=5
SHARD_STREAM_MAX_REQUEST_SIZE=1048576
