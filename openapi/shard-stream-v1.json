{
  "openapi": "3.2.0",
  "info": {
    "title": "shard-stream native REST API",
    "version": "0.1.0",
    "description": "Native control API and binary append/fetch data path."
  },
  "paths": {
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "Process is healthy"
          }
        }
      }
    },
    "/v1/topology": {
      "get": {
        "summary": "Get static cluster membership and advertised endpoints",
        "responses": {
          "200": {
            "description": "Current static topology and ownership algorithm",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "cluster_mode",
                    "local_node_id",
                    "topology_digest",
                    "ownership",
                    "nodes"
                  ],
                  "properties": {
                    "cluster_mode": {
                      "type": "string"
                    },
                    "local_node_id": {
                      "type": "integer",
                      "format": "uint32"
                    },
                    "topology_digest": {
                      "type": "string"
                    },
                    "ownership": {
                      "type": "string"
                    },
                    "nodes": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/topics": {
      "post": {
        "summary": "Create a topic",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTopic"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Topic created"
          },
          "409": {
            "description": "Topic already exists"
          }
        }
      }
    },
    "/v1/topics/{topic_id}/partitions/{partition_id}/records": {
      "post": {
        "summary": "Append one opaque record batch",
        "parameters": [
          {
            "name": "topic_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "partition_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "record_count",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "request_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional unsigned 128-bit request identifier"
          },
          {
            "name": "durability",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "leader",
                "quorum",
                "object"
              ],
              "default": "leader"
            }
          },
          {
            "name": "producer_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Unsigned 128-bit idempotent producer identifier; supply with producer_epoch and first_sequence"
          },
          {
            "name": "producer_epoch",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "first_sequence",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "uint64"
            }
          },
          {
            "name": "leader_epoch",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "description": "Required fencing token when the broker uses Blossom-backed leases"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Append committed at the requested durability"
          },
          "429": {
            "description": "Admission budget exhausted"
          },
          "409": {
            "description": "Producer or leader epoch is fenced"
          }
        }
      },
      "get": {
        "summary": "Fetch ordered or as-available binary batches",
        "responses": {
          "200": {
            "description": "Length-delimited shard-stream v1 batches",
            "content": {
              "application/vnd.shard-stream.batch.v1": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/v1/topics/{topic_id}/partitions/{partition_id}/watermarks": {
      "get": {
        "summary": "Read partition visibility and durability watermarks",
        "responses": {
          "200": {
            "description": "Current partition watermarks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Watermarks"
                }
              }
            }
          }
        }
      }
    },
    "/v1/topics/{topic_id}/partitions/{partition_id}/retention": {
      "put": {
        "summary": "Advance the retained log start at a batch boundary",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Retention"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retention advanced and fully expired sealed packs reclaimed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Watermarks"
                }
              }
            }
          },
          "400": {
            "description": "Offset is not monotonic or batch aligned"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateTopic": {
        "type": "object",
        "required": [
          "topic_id",
          "partitions"
        ],
        "properties": {
          "topic_id": {
            "type": "string",
            "description": "Unsigned 128-bit decimal identifier"
          },
          "partitions": {
            "type": "integer",
            "minimum": 1
          },
          "shards": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "Retention": {
        "type": "object",
        "required": [
          "log_start"
        ],
        "properties": {
          "log_start": {
            "type": "string",
            "description": "Unsigned 128-bit decimal batch-boundary offset"
          }
        }
      },
      "Watermarks": {
        "type": "object",
        "required": [
          "log_start",
          "allocated_end",
          "contiguous_log_end",
          "replicated_high_watermark",
          "last_stable_offset"
        ],
        "properties": {
          "log_start": {
            "type": "string"
          },
          "allocated_end": {
            "type": "string"
          },
          "contiguous_log_end": {
            "type": "string"
          },
          "replicated_high_watermark": {
            "type": "string"
          },
          "last_stable_offset": {
            "type": "string"
          }
        }
      }
    }
  }
}
